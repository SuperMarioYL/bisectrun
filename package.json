{
  "name": "bisectrun",
  "version": "0.10.0",
  "description": "Compare Claude Code transcripts and locate the first differing tool-input fingerprint, with JSON output and a local diff UI.",
  "type": "module",
  "bin": {
    "bisect-run": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./parse-jsonl": "./dist/parse-jsonl.js",
    "./align": "./dist/align.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "demo:capture": "DEMO_CAPTURE=1 node --test --import tsx test/demo.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "coding-agent",
    "bisect",
    "debugging",
    "claude-code",
    "agent",
    "trace",
    "span",
    "observability"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "commander": "^13.0.0",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
